# คัดลอกเป็น .env แล้วใส่ค่าจริง ห้าม commit .env
# เครื่องนักพัฒนาใช้ config.settings.local อยู่แล้ว ส่วน Docker ตั้งเป็น production ให้เอง
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# production เท่านั้น
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=86400
# พอร์ตในเครื่องเซิร์ฟเวอร์ที่ reverse proxy ส่งต่อเข้ามา ต้องไม่ชนกับงานอื่น
HOST_PORT=8023
# บนเซิร์ฟเวอร์ตั้งเป็น HTTP_X_REAL_IP ใช้ได้เพราะ compose เปิดพอร์ตเฉพาะ 127.0.0.1
CLIENT_IP_HEADER=
# เว้นว่างในเครื่องเพื่อให้งานเบื้องหลังทำทันที ใน Docker ใช้ redis ใน compose
REDIS_URL=

# Docker สร้างฐานข้อมูลจาก 3 ค่านี้ ส่วน DB_HOST กับ DB_PORT compose ตั้งให้เอง
DB_NAME=fh_app
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# อีเมล Hostinger: ถ้าเว้น EMAIL_HOST_USER ไว้ ระบบจะพิมพ์อีเมลลง console แทนการส่งจริง
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# ข้อมูลติดต่อที่แสดงบนเว็บ
SITE_PHONE=
SITE_EMAIL=contact@findinghouse.co.th
SITE_LINE_ID=@findinghouse
SITE_LINE_URL=https://line.me/R/ti/p/@findinghouse

# แชทบอท: ลำดับการลองผู้ให้บริการ คั่นด้วยจุลภาค เช่น local,claude,deepseek,groq,gemini
# เว้นว่างหรือใช้ไม่ได้ทั้งหมด จะตอบด้วยกฎพื้นฐานและค้นทรัพย์จากฐานข้อมูล
LLM_PROVIDERS=
LLM_LOCAL_BASE_URL=
LLM_LOCAL_API_KEY=
LLM_LOCAL_MODEL=
ANTHROPIC_API_KEY=
LLM_CLAUDE_MODEL=claude-opus-5-5
DEEPSEEK_API_KEY=
LLM_DEEPSEEK_MODEL=
GROQ_API_KEY=
LLM_GROQ_MODEL=
GEMINI_API_KEY=
LLM_GEMINI_MODEL=
